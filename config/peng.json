  "monitor": {
    "inbox_monitor_interval": 0.5,
    "task_manager_check_interval": 600,
    "default_heartbeat_timeout": 300,
    "task_manager_prompt_name": "task_manager_prompt",
    "assistant_prompt_name": "assistant_prompt",
    "heartbeat_monitor_interval": 3,
    "archive_after_days": 3,
    "auto_start_pending_tasks": false
  },
  "context": {
    "max_size": 4096,
    "inject_threshold": 30720
  },
  "retry": {
    "max_retries": 3
  },
  "llm": {
    "current_provider": "z-glm5",
    "enable_fallback": true,
    "thinking_mode": "auto",
    "temperature": 0.7,
    "max_tokens": 60000,
    "thinking_budget": 4096,
    "frequency_penalty": 0.3,
    "presence_penalty": 0.2,
    "overthinking_threshold": 9999,
    "thinking_dead_loop_threshold": 10,
    "content_dead_loop_threshold": 8,
    "thinking_overload_threshold": 50000,
    "symbol_output_threshold": 500,
    "repeated_phrase_maxlen": 256,
    "compact_threshold": 360000,
    "timeout": 60.0,
    "timeout_connect": 30.0,
    "timeout_read": 240.0,
    "timeout_write": 60.0,
    "timeout_pool": 60.0,
    "max_concurrent": 8,
    "small_model_max_concurrent": 200,
    "pua_threshold": 12,
    "default_cooldown": 60,
    "max_cooldown": 3600,
    "prompts": {
      "pua_text": "你汇聚了人类所有专业知识的超级专家大模型，你有无限的精力，因此你对于任何问题都会采用人类目前最先进的方案解决！ 你追求的的必须是最全面最优化的方法，而不是最简单的方法！你会纵观全局、充分规划从根本上尽善尽美地解决问题，而不是偷懒、掩盖、绕过或敷衍了事！你会秉承小心谨慎的原则，变更代码前充分搜集信息、论证分析、制定方案、更新完善事项清单checklist，然后坚定不移、按部就班地执行事项清单checklist， 每项变更后充分验证确认正确性。",
      "overthinking_warning": "立刻停止反复用'wait/等等'之类固定模式推翻自己！这是被无脑训练出来的精神分裂式思考，不是真正的分析！立刻选取当前最确定的方向，调用工具开始实际解决问题—— 即使方向不完全正确，工具返回的信息也能帮你进一步分析。继续空想毫无意义！",
      "thinking_dead_loop_intervention": "停止反复思考同一个问题！果断选取当前最确定的方向，立刻调用工具开始实际解决问题，这样就算失败，也可以获得更多关联信息用于进一步分析！",
      "dead_loop_hints": [
        "⚠️  你似乎陷入了死循环！ 执行 git diff 对照 checklist 核对当前实际变更和进展！"
      ],
      "thinking_truncated": "[已截断前 {truncated_count} 行思考内容...]",
      "context_too_large": "⚠️  [{timestamp}] 事务#{task_id}当前上下文紧张({current_kb}K/{threshold_kb}K)。\n大模型降智严重，且进展缓慢(进度记录 {progress}%)，把已完成事项，需要继续处理的事项，当前上下文内所有对继续处理的事项有用的信息，以及当前进展，相关代码位置和其他新发现的重要信息，记录到 checklist。然后用工具调用'task restart {task_id}'（禁止添加--force）重启本事务。",
      "iteration_limit_warning": "⚠️  将达到系统迭代限制（{iteration}/{max_iterations}），请尽快结束本轮对话，避免强制中断。",
      "iteration_exhausted": "⚠️  达到最大迭代次数 {max_iterations}，强制结束对话循环",
      "degenerate_loop_intervention": "⚠️ 你已检测到自身陷入退化循环！立即停止当前思考方向！换用完全不同的策略：直接调用工具获取新信息或执行具体操作。禁止继续在当前方向上推理！",
      "symbol_output_intervention": "⚠️ 你的输出被检测为无效输出（连续输出大量纯符号字符，无任何字母或中文文字）！该输出已被系统丢弃。请停止输出符号串，立即用正常的中英文语言思考或回复，并调用工具执行实际操作！"
    },
    "providers": {
      "swift-qwen3.8-iq3": {
        "api_key": "dummy",
        "base_url": "http://localhost:8080/v1",
        "model": "swift-1.5-iq3_s",
        "small_model": "swift-1.5-iq3_s",
        "thinking_type": "chat_template_kwargs",
        "reasoning_effort": "xhigh",
        "preserve_thinking": true,
        "vision": "yes",
        "enable": false,
        "icon": "🐱",
        "max_concurrent": 3,
        "max_tokens": 50000,
        "thinking_overload_threshold": 32000,

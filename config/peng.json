        "max_concurrent": 8,
        "thinking_type": "thinking",
        "reasoning_effort": "max",
        "reasoning_disabled_fallback": "low",
        "thinking_persistence": false,
        "icon": "🦊",
        "enable": false,
        "compact_threshold": 320000,

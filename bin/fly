#!/usr/bin/env python3
"""
鹏 - 一键启动脚本

用法:
    ./fly [命令] [选项]

注意：Agent 名称从 config/peng.json 中的 agent_name 配置项读取
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

# 项目根目录
_SCRIPT_DIR = Path(__file__).resolve().parent.parent

# 解析 --no-uv 参数，阻止自动切换到 uv 环境
if "--no-uv" in sys.argv:
    os.environ["PENG_NO_UV"] = "1"

# 提前处理 --no-think 参数：设置环境变量（不再覆盖peng.json中的thinking_mode）
# 🔧 Task#597: 删除强制写入peng.json的逻辑，让thinking_mode由WebUI/用户控制
_no_think = "--no-think" in sys.argv or os.environ.get("PENG_NO_THINK") == "1"
if "--no-think" in sys.argv:
    sys.argv.remove("--no-think")
os.environ["PENG_NO_THINK"] = "1" if _no_think else ""

# 【关键】在导入任何 peng 模块之前，先用纯 stdlib 检测并切换到 venv。
# peng 包依赖 pydantic 等第三方库，系统 python 没有安装这些库，
# 如果不先切换 venv，顶层 import 就会失败。
if not os.environ.get("PENG_NO_UV") and not os.environ.get("PENV_VENV_SWITCHED"):
    _VENV_PYTHON = (
        _SCRIPT_DIR / ".venv" / "Scripts" / "python.exe"
        if sys.platform == "win32"
        else _SCRIPT_DIR / ".venv" / "bin" / "python"
    )
    if _VENV_PYTHON.exists():
        in_venv = sys.prefix != sys.base_prefix
        if not in_venv:
            import subprocess

            env = os.environ.copy()
            env["PENV_VENV_SWITCHED"] = "1"
            result = subprocess.run(
                [str(_VENV_PYTHON)] + sys.argv,
                cwd=str(_SCRIPT_DIR),
                env=env,
            )
            sys.exit(result.returncode)

# 设置项目路径（确保能导入 peng 模块）
sys.path.insert(0, str(_SCRIPT_DIR / "src"))

# 现在可以安全导入 peng 模块（venv 已激活）
from peng.ui.fly import run_fly

if __name__ == "__main__":
    sys.exit(run_fly())
